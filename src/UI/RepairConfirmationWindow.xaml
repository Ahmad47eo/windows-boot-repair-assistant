<Window x:Class="WindowsBootRepair.UI.RepairConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Final Confirmation" Height="200" Width="400"
        WindowStartupLocation="CenterOwner" Background="#F0F0F0"
        FontFamily="Segoe UI" FontSize="12">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="20">
            <TextBlock Text="Final Confirmation Required" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
            <TextBlock Text="Type REPAIR (all caps) to confirm and proceed." FontSize="11" Margin="0,0,0,10" Foreground="#D32F2F" FontWeight="Bold"/>
            <TextBlock Text="Any other input will cancel the repair." FontSize="11" Margin="0,0,0,15" Foreground="#666666"/>
            
            <TextBlock Text="Confirmation:" FontSize="11" Margin="0,0,0,5"/>
            <TextBox x:Name="ConfirmationInput" Height="35" Padding="10" FontFamily="Consolas" FontSize="12" Margin="0,0,0,15"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Click="CancelBtn_Click" Background="#CCCCCC" Foreground="Black" Padding="20,10" Margin="0,0,10,0" FontSize="11">Cancel</Button>
                <Button x:Name="ConfirmBtn" Click="ConfirmBtn_Click" Background="#D32F2F" Foreground="White" Padding="20,10" FontSize="11" FontWeight="Bold">Confirm</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
